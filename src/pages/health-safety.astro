---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import HealthSafetyGrid from "../components/HealthSafetyGrid.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CallToAction from "../components/CallToAction.astro";
import DaycareGallery from "../components/DaycareGallery.astro";
import { pageSeo } from "../data/seo";
import { mealsNutritionText, mealsDisclaimer, parentCommunicationItems } from "../data/content";
import { siteConfig } from "../data/siteConfig";
import { safetyGalleryImages } from "../data/gallery";

const seo = pageSeo.safety;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.path}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  currentPath="/health-safety"
>
  <section class="section">
    <div class="container">
      <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Health & Safety" }]} />
      <SectionHeading
        title="Health and Safety"
        description="Safety, supervision, and family communication are central to daily care."
      />
      <p>{siteConfig.licensingStatement}</p>
      <p class="notice">{siteConfig.licensingPlaceholderNotice}</p>
    </div>
  </section>

  <HealthSafetyGrid />

  <DaycareGallery
    images={safetyGalleryImages}
    eyebrow="Safety In Practice"
    title="Safe Spaces Families Can Trust"
    description="Our daily environment supports supervision, healthy routines, and child comfort from playtime through rest time."
  />

  <section class="section">
    <div class="container grid grid-2">
      <article class="card">
        <h2>Meals and Nutrition</h2>
        <p>{mealsNutritionText}</p>
        <p class="disclaimer">{mealsDisclaimer}</p>
      </article>

      <article class="card">
        <h2>Parent Communication</h2>
        <p>Families may receive:</p>
        <ul>
          {parentCommunicationItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <CallToAction
    title="Discuss Your Family’s Health and Safety Questions"
    text="Contact us to review routines, communication expectations, and enrollment-related care information."
    primaryLabel="Contact Us"
    primaryHref="/contact"
  />
</BaseLayout>

<style>
  .notice {
    background: var(--color-cream-100);
    border-left: 4px solid var(--color-sun-200);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
  }

  .disclaimer {
    font-style: italic;
  }

  ul {
    margin: 0;
    padding-left: 1.2rem;
  }
</style>
