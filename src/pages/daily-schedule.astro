---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ScheduleTimeline from "../components/ScheduleTimeline.astro";
import CallToAction from "../components/CallToAction.astro";
import { pageSeo } from "../data/seo";

const seo = pageSeo.schedule;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.path}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  currentPath="/daily-schedule"
>
  <section class="section">
    <div class="container">
      <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Daily Schedule" }]} />
      <h1>Daily Schedule</h1>
      <p>
        Children benefit from a predictable rhythm that balances learning, meals, movement, rest, and supervised play.
      </p>
    </div>
  </section>

  <ScheduleTimeline />

  <CallToAction
    title="Questions About Daily Routine?"
    text="We are happy to discuss how daily activities can support your child’s development and comfort."
    primaryLabel="Contact Us"
    primaryHref="/contact"
  />
</BaseLayout>
