---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FeatureCard from "../components/FeatureCard.astro";
import ValueCard from "../components/ValueCard.astro";
import ProgramCard from "../components/ProgramCard.astro";
import ScheduleTimeline from "../components/ScheduleTimeline.astro";
import HealthSafetyGrid from "../components/HealthSafetyGrid.astro";
import TestimonialSection from "../components/TestimonialSection.astro";
import CallToAction from "../components/CallToAction.astro";
import ContactPreview from "../components/ContactPreview.astro";
import EnrollmentInquiryButton from "../components/EnrollmentInquiryButton.astro";
import DaycareGallery from "../components/DaycareGallery.astro";
import { pageSeo } from "../data/seo";
import {
  welcomeContent,
  mission,
  vision,
  programDisclaimer,
  learningProgramSupport,
  enrollmentHighlights
} from "../data/content";
import { parentChoiceFeatures, learningProgramItems } from "../data/features";
import { coreValues } from "../data/values";
import { programs } from "../data/programs";
import { daycareGalleryImages } from "../data/gallery";

const seo = pageSeo.home;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.path}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  currentPath="/"
>
  <Hero />

  <section class="section">
    <div class="container">
      <SectionHeading title={welcomeContent.heading} description={welcomeContent.intro} />
      <div class="grid grid-2">
        <article class="card">
          <p>{welcomeContent.body}</p>
          <p>{welcomeContent.supporting}</p>
          <ul class="highlights">
            {enrollmentHighlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="card surface-blue">
          <h3>Our Mission</h3>
          <p>{mission}</p>
          <h3>Our Vision</h3>
          <p>{vision}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section surface-cream">
    <div class="container">
      <SectionHeading eyebrow="Why Parents Choose Us" title="Trusted Care in a Warm Family Setting" centered={true} />
      <div class="grid grid-4">
        {parentChoiceFeatures.map((feature) => (
          <FeatureCard title={feature} />
        ))}
      </div>
    </div>
  </section>

  <DaycareGallery
    images={daycareGalleryImages}
    eyebrow="Daily Love Spaces"
    title="A Beautiful Look at Our Daycare Environment"
    description="From early learning corners to creative play areas, every part of our space is designed to help children feel safe, joyful, and supported."
  />

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Ages We Serve" title="Programs" />
      <div class="grid grid-3">
        {programs.map((program) => (
          <ProgramCard title={program.name} description={program.description} />
        ))}
      </div>
      <p class="disclaimer">{programDisclaimer}</p>
      <EnrollmentInquiryButton />
    </div>
  </section>

  <section class="section surface-blue">
    <div class="container">
      <SectionHeading eyebrow="Core Values" title="Love, Safety, and Growth Every Day" />
      <div class="grid grid-3">
        {coreValues.map((value) => (
          <ValueCard title={value.title} description={value.description} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Learning Program"
        title="Play-Based Learning for Whole-Child Development"
        description={learningProgramSupport}
      />
      <div class="grid grid-4">
        {learningProgramItems.map((item) => (
          <FeatureCard title={item} icon="•" />
        ))}
      </div>
    </div>
  </section>

  <ScheduleTimeline />
  <HealthSafetyGrid />
  <TestimonialSection />

  <CallToAction
    title="Enrollment Open for Inquiries"
    text="Spaces are limited. Call or text (240) 643-6616 or email asrata33@gmail.com to discuss your child’s needs and schedule a tour."
    primaryLabel="Schedule a Tour"
    primaryHref="/contact"
    secondaryLabel="Request Enrollment Information"
    secondaryHref="/enrollment"
  />

  <ContactPreview />
</BaseLayout>

<style>
  .disclaimer {
    margin-top: var(--space-5);
    font-style: italic;
  }

  .highlights {
    margin-top: var(--space-4);
    padding-left: 1.2rem;
  }

  .highlights li + li {
    margin-top: 0.35rem;
  }
</style>
