---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingCallButton from "../components/FloatingCallButton.astro";
import { siteConfig } from "../data/siteConfig";
import { baseSeo } from "../data/seo";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  currentPath: string;
}

const {
  title,
  description,
  canonicalPath,
  ogTitle = title,
  ogDescription = description,
  ogImage = siteConfig.seo.defaultOgImage,
  currentPath
} = Astro.props;

const canonical = new URL(canonicalPath, siteConfig.canonicalUrl).toString();

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ChildCare",
  name: siteConfig.businessName,
  description,
  url: siteConfig.canonicalUrl,
  telephone: siteConfig.phone,
  email: siteConfig.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: siteConfig.streetAddress,
    addressLocality: siteConfig.city,
    addressRegion: siteConfig.state,
    postalCode: siteConfig.zip,
    addressCountry: "US"
  },
  areaServed: {
    "@type": "AdministrativeArea",
    name: `${siteConfig.county}, ${siteConfig.state}`
  },
  openingHours: siteConfig.businessHours,
  image: new URL(ogImage, siteConfig.canonicalUrl).toString()
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={baseSeo.locale} />
    <meta property="og:site_name" content={baseSeo.siteName} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, siteConfig.canonicalUrl).toString()} />

    <meta name="twitter:card" content={siteConfig.seo.twitterCard} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL(ogImage, siteConfig.canonicalUrl).toString()} />

    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <FloatingCallButton />
  </body>
</html>
