---
import { siteConfig } from "../data/siteConfig";
import { hasUsableUrl } from "../data/siteConfig";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-grid">
    <section>
      <h2 class="sr-only">Business information</h2>
      <p class="name">{siteConfig.businessName}</p>
      <p>{siteConfig.county}, {siteConfig.state}</p>
      <p><a href={`tel:${siteConfig.phone}`}>{siteConfig.phone}</a></p>
      <p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
      <p>{siteConfig.licensingStatement}</p>
      <p class="small">{siteConfig.licensingPlaceholderNotice}</p>
    </section>

    <section>
      <h2>Quick Links</h2>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/programs">Programs</a></li>
        <li><a href="/daily-schedule">Daily Schedule</a></li>
        <li><a href="/health-safety">Health &amp; Safety</a></li>
        <li><a href="/enrollment">Enrollment Inquiry</a></li>
        <li><a href="/contact">Schedule a Tour</a></li>
        <li><a href="/privacy-policy">Privacy Policy</a></li>
      </ul>
    </section>

    <section>
      <h2>Social and Accessibility</h2>
      <ul>
        <li>
          {hasUsableUrl(siteConfig.socialLinks.facebook) ? (
            <a href={siteConfig.socialLinks.facebook}>Facebook</a>
          ) : (
            <span>Facebook placeholder</span>
          )}
        </li>
        <li>
          {hasUsableUrl(siteConfig.socialLinks.instagram) ? (
            <a href={siteConfig.socialLinks.instagram}>Instagram</a>
          ) : (
            <span>Instagram placeholder</span>
          )}
        </li>
        <li>
          {hasUsableUrl(siteConfig.socialLinks.x) ? (
            <a href={siteConfig.socialLinks.x}>X</a>
          ) : (
            <span>X placeholder</span>
          )}
        </li>
        <li>
          {hasUsableUrl(siteConfig.accessibilityStatementUrl) ? (
            <a href={siteConfig.accessibilityStatementUrl}>Accessibility Statement</a>
          ) : (
            <span>Accessibility Statement placeholder</span>
          )}
        </li>
      </ul>
    </section>
  </div>

  <div class="container legal">
    <p>© {year} {siteConfig.businessName}. All rights reserved.</p>
    <p>
      Program details, schedules, meals, availability, and services are subject to change. Please contact Daily
      Love Family Daycare for current information.
    </p>
  </div>
</footer>

<style>
  .footer {
    background:
      radial-gradient(circle at 10% -20%, rgba(255, 220, 147, 0.18), transparent 45%),
      radial-gradient(circle at 90% -15%, rgba(173, 216, 255, 0.2), transparent 42%),
      linear-gradient(180deg, #14334a 0%, #102c40 100%);
    color: #f4f8fb;
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
  }

  .footer a {
    color: #e2f1ff;
    text-underline-offset: 0.14em;
  }

  .footer a:hover {
    color: #ffffff;
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin-bottom: var(--space-2);
    color: #ffffff;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: var(--space-8);
  }

  h2 {
    font-size: 1.05rem;
    font-family: var(--font-sans);
    color: #ffffff;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-3);
    display: inline-block;
    position: relative;
    padding-bottom: 0.35rem;
  }

  h2::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 2.1rem;
    height: 2px;
    background: linear-gradient(90deg, #ffd98a, #b9defb);
    border-radius: 999px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  li::before {
    content: "";
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 999px;
    background: rgba(230, 243, 255, 0.72);
    flex: 0 0 auto;
  }

  .small {
    font-size: 0.9rem;
    color: #c6dff2;
  }

  .legal {
    border-top: 1px solid rgba(214, 235, 255, 0.25);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
  }

  .legal p {
    color: #e2eef9;
    margin-bottom: var(--space-2);
  }

  @media (max-width: 56rem) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
