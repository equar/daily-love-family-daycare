---
import { siteConfig } from "../data/siteConfig";
import DesktopNav from "./DesktopNav.astro";
import MobileNav from "./MobileNav.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="announcement" role="status" aria-live="polite">
    <div class="container">
      <p>{siteConfig.enrollmentStatus}</p>
    </div>
  </div>

  <div class="header-shell">
    <div class="container inner">
      <a class="brand" href="/" aria-label="Daily Love Family Daycare home">
        <span class="name">{siteConfig.businessName}</span>
        <span class="tagline">{siteConfig.tagline}</span>
      </a>

      <DesktopNav currentPath={currentPath} />

      <div class="actions">
        <a class="phone" href={`tel:${siteConfig.phone}`}>{siteConfig.phone}</a>
        <a class="button" href="/contact">Schedule a Tour</a>
        <MobileNav currentPath={currentPath} />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 2px 10px rgba(19, 49, 69, 0.08);
  }

  .announcement {
    background: linear-gradient(90deg, #ffd97a 0%, #ffdca7 34%, #f8dbe4 100%);
    font-weight: 700;
    font-size: 0.94rem;
  }

  .announcement p {
    margin: 0;
    padding: 0.58rem 0;
    text-align: center;
    color: var(--color-ink-900);
  }

  .header-shell {
    background: rgba(255, 255, 255, 0.88);
    border-bottom: 1px solid rgba(203, 220, 233, 0.9);
    backdrop-filter: blur(12px);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4.75rem;
  }

  .brand {
    text-decoration: none;
    color: inherit;
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .name {
    font-family: var(--font-serif);
    font-size: clamp(1.08rem, 1vw + 0.85rem, 1.35rem);
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .tagline {
    font-size: 0.82rem;
    color: var(--color-ink-600);
    font-weight: 600;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .phone {
    display: none;
    text-decoration: none;
    font-weight: 700;
    color: var(--color-sky-700);
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgba(231, 242, 251, 0.85);
  }

  .button {
    display: none;
  }

  @media (min-width: 64rem) {
    .phone,
    .button {
      display: inline-flex;
    }
  }

  @media (max-width: 37rem) {
    .tagline {
      display: none;
    }
  }
</style>
