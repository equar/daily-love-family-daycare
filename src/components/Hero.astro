---
import { heroContent } from "../data/content";
---

<section class="hero section surface-cream reveal-on-scroll" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div>
      <p class="pill">Licensed Family Childcare in Montgomery County, Maryland</p>
      <h1 id="hero-title">{heroContent.title}</h1>
      <p>{heroContent.text}</p>
      <div class="buttons">
        <a class="button" href="/contact">Schedule a Tour</a>
        <a class="button secondary" href="/programs">View Our Programs</a>
      </div>
    </div>

    <figure class="hero-image card">
      <img
        src="/images/daycare/daycare-hero-scene.svg"
        width="800"
        height="560"
        loading="eager"
        decoding="async"
        alt="Warm and welcoming family daycare room with learning shelves, reading corner, and play activity stations."
      />
      <figcaption>Family-style care, learning, and play in a safe and nurturing setting.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-10);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 8px;
    background: linear-gradient(90deg, #ffd37c 0%, #f8bed1 42%, #bfe1ff 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .buttons {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hero-image {
    padding: var(--space-3);
    margin: 0;
    background: linear-gradient(180deg, #ffffff, #fbfdff);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: 0.84rem;
    color: var(--color-ink-700);
  }

  @media (max-width: 56rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
