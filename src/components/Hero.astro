---
import { heroContent } from "../data/content";
---

<section class="hero section surface-cream" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div>
      <p class="pill">Licensed Family Childcare in Montgomery County, Maryland</p>
      <h1 id="hero-title">{heroContent.title}</h1>
      <p>{heroContent.text}</p>
      <div class="buttons">
        <a class="button" href="/contact">Schedule a Tour</a>
        <a class="button secondary" href="/programs">View Our Programs</a>
      </div>
    </div>

    <figure class="hero-image card">
      <img
        src="/images/hero-placeholder.svg"
        width="800"
        height="560"
        loading="eager"
        decoding="async"
        alt="Warm and supervised daycare learning environment with diverse children engaged in reading, art, and guided play with caregivers."
      />
      <figcaption>Replace with a licensed, permission-cleared daycare photo before publishing.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-10);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .buttons {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hero-image {
    padding: var(--space-3);
    margin: 0;
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: 0.84rem;
    color: var(--color-ink-700);
  }

  @media (max-width: 56rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
