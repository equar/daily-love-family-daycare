---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  centered?: boolean;
}

const { eyebrow, title, description, centered = false } = Astro.props;
---

<header class={`section-heading ${centered ? "centered" : ""}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p class="lead">{description}</p>}
</header>

<style>
  .section-heading {
    margin-bottom: var(--space-8);
    max-width: 42rem;
  }

  .section-heading.centered {
    margin-inline: auto;
    text-align: center;
  }

  .eyebrow {
    color: var(--color-sky-700);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
    font-size: 0.85rem;
  }

  .lead {
    font-size: 1.05rem;
  }
</style>
