---
import { navigation } from "../data/navigation";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<nav aria-label="Primary" class="desktop-nav">
  <ul>
    {navigation.map((item) => {
      const isActive = currentPath === item.href;
      return (
        <li>
          <a href={item.href} aria-current={isActive ? "page" : undefined}>
            {item.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .desktop-nav {
    display: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: var(--space-5);
    align-items: center;
  }

  a {
    text-decoration: none;
    color: var(--color-ink-900);
    font-weight: 700;
    padding: var(--space-2) var(--space-1);
    border-bottom: 2px solid transparent;
  }

  a[aria-current="page"] {
    border-bottom-color: var(--color-sky-700);
  }

  @media (min-width: 64rem) {
    .desktop-nav {
      display: block;
    }
  }
</style>
